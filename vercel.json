{
  "functions": {
    "server.js": {
      "includeFiles": "**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*\\.(?:webp|jpg|jpeg|png|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
